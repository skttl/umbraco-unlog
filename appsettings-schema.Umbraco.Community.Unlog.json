{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Umbraco.Community.Unlog configuration",
  "type": "object",
  "properties": {
    "Umbraco": {
      "type": "object",
      "properties": {
        "Community": {
          "type": "object",
          "properties": {
            "Unlog": {
              "type": "object",
              "description": "Retention rules for Umbraco's own Serilog file logs. No rules means no deletion.",
              "properties": {
                "Delay": {
                  "type": "string",
                  "description": "TimeSpan before the first cleanup after startup.",
                  "default": "00:15:00",
                  "examples": ["00:15:00"]
                },
                "Period": {
                  "type": "string",
                  "description": "TimeSpan between recurring cleanup runs. Must be greater than zero.",
                  "default": "1.00:00:00",
                  "examples": ["1.00:00:00"]
                },
                "Rules": {
                  "type": "array",
                  "description": "Each rule deletes events older than Days at Level and every lower level. If rules overlap, the shortest applicable retention wins.",
                  "items": {
                    "type": "object",
                    "required": ["Level", "Days"],
                    "properties": {
                      "Level": {
                        "type": "string",
                        "description": "Highest level covered by this rule. All explicitly covers every level.",
                        "enum": ["Verbose", "Debug", "Information", "Warning", "Error", "Fatal", "All"]
                      },
                      "Days": {
                        "type": "integer",
                        "description": "Keep matching log events for this many days.",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
